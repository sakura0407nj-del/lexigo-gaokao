{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "components/learn",
    "lib/learning-*.ts",
    "lib/ai-schemas.ts",
    "lib/public-*.ts",
    "lib/job-*.ts",
    "lib/vocabulary-catalog.ts",
    "app/api",
    "netlify/functions",
    "vite.public.config.ts"
  ],
  "exclude": [
    "node_modules",
    "work"
  ]
}
